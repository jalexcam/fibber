{
	"name": "jalexcam/fibber",
	"type": "library",
	"description": "Fibber is a PHP library that generates fake data.",
	"keywords": ["fibber","data", "jalexcam"],
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Alexander Campo",
			"email": "jalexcam@gmail.com"
		}
	],
	"require": {
		"php": "^8.3",
		"psr/container": "^2.0",
		"symfony/deprecation-contracts": "^2.2 || ^3.0"
	},
	"autoload": {
        "psr-4": {
            "Fibber\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
	"prefer-stable": true
}
